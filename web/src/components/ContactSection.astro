<section class="section section--contact" id="contact" aria-labelledby="contact-title">
  <div class="shell contact-grid">
    <div class="contact-copy">
      <p class="section-index">05 / Contact</p>
      <h2 id="contact-title">Start with a short note.</h2>
      <p class="contact-lede">
        A short note is enough. We’ll reply with a few useful questions and a
        straight answer about fit. No deck required.
      </p>

      <div class="fit-notes">
        <div>
          <span class="mono">Good fit</span>
          <p>Lifecycle builds, CMS replatforms, messy systems that need a clear owner.</p>
        </div>
        <div>
          <span class="mono">Probably not</span>
          <p>One-off blasts, 24-hour turnarounds, or a deck with no build behind it.</p>
        </div>
      </div>

      <a class="contact-email" href="mailto:hello@loopwork.studio">hello@loopwork.studio</a>
    </div>

    <div class="contact-form-panel">
      <form id="contact-form" novalidate>
        <div class="form-summary" id="contact-summary" role="alert" tabindex="-1" hidden></div>
        <div class="form-grid">
          <div class="field">
            <label for="contact-name">Name <span aria-hidden="true">*</span></label>
            <input class="input" id="contact-name" name="name" type="text" autocomplete="name" required aria-describedby="contact-name-error" />
            <p class="form-error" id="contact-name-error" hidden></p>
          </div>
          <div class="field">
            <label for="contact-email">Work email <span aria-hidden="true">*</span></label>
            <input class="input" id="contact-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="contact-email-error" />
            <p class="form-error" id="contact-email-error" hidden></p>
          </div>
          <div class="field field--full">
            <label for="contact-company">Company</label>
            <input class="input" id="contact-company" name="company" type="text" autocomplete="organization" />
          </div>
          <div class="field field--full">
            <label for="contact-message">What are you trying to fix? <span aria-hidden="true">*</span></label>
            <textarea class="input textarea" id="contact-message" name="message" rows="5" required aria-describedby="contact-message-error"></textarea>
            <p class="form-error" id="contact-message-error" hidden></p>
          </div>
        </div>
        <div class="form-actions">
          <button class="btn btn--ink" id="contact-submit" type="submit">
            <span class="button-label">Send project note</span>
          </button>
          <p class="form-note">Demo form. Nothing is sent.</p>
        </div>
      </form>

      <div class="form-success" id="contact-success" hidden aria-live="polite">
        <h3>Note saved in the demo.</h3>
        <p>Nothing was sent. In a live build, your note would land in Loopwork’s inbox.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement
  const summary = document.getElementById('contact-summary') as HTMLElement
  const success = document.getElementById('contact-success') as HTMLElement

  const rules: Record<string, (v: string) => string> = {
    name: (v) => (v.trim() ? '' : 'Please enter your name.'),
    email: (v) => {
      if (!v.trim()) return 'Please enter your work email.'
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) ? '' : 'That email doesn’t look right.'
    },
    message: (v) => (v.trim().length >= 10 ? '' : 'Tell us a bit more (at least 10 characters).'),
  }

  function validateField(name: string): string {
    const input = form.elements.namedItem(name) as HTMLInputElement
    const error = document.getElementById(`contact-${name}-error`) as HTMLElement
    const message = rules[name](input.value)
    error.textContent = message
    error.hidden = !message
    input.setAttribute('aria-invalid', message ? 'true' : 'false')
    return message
  }

  // Re-validate a field as the user leaves it
  Object.keys(rules).forEach((name) => {
    const input = form.elements.namedItem(name) as HTMLInputElement
    input.addEventListener('blur', () => validateField(name))
  })

  form.addEventListener('submit', (e) => {
    e.preventDefault()
    const failed = Object.keys(rules).filter((name) => validateField(name))

    if (failed.length) {
      summary.textContent = `Please fix ${failed.length} field${failed.length > 1 ? 's' : ''} before sending.`
      summary.hidden = false
      summary.focus()
      return
    }

    summary.hidden = true
    form.hidden = true
    success.hidden = false
  })
</script>