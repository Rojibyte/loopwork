---
interface Props {
  tone?: "light" | "dark";
}

const { tone = "light" } = Astro.props;
const wordmark = tone === "dark" ? "text-white" : "text-ink";
---

<a href="/" class="inline-flex items-center gap-2.5 no-underline" aria-label="loopwork home">
  <span
    class="grid size-8 shrink-0 place-items-center rounded-[9px] bg-lime text-forest"
    aria-hidden="true"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path
        d="M8 2.4a5.6 5.6 0 1 1-4.7 2.5"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
      />
      <path
        d="M3.2 3.1v2.6h2.6"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </span>
  <span class:list={["font-display text-[1.05rem] font-semibold tracking-[-0.03em]", wordmark]}>
    loopwork
  </span>
</a>
