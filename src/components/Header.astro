---
import Logo from "./Logo.astro";
import MobileNav from "./MobileNav.astro";
import { siteNav } from "../lib/nav";
---

<header class="sticky top-0 z-40 bg-paper/90 backdrop-blur-md">
  <MobileNav>
    <Logo />
    <nav class="hidden md:block" aria-label="Primary">
      <ul class="flex items-center gap-8">
        {
          siteNav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-[15px] font-medium text-muted no-underline transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </MobileNav>
</header>
